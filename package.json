{
  "name": "api-hono-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready TypeScript API with Hono, Drizzle, Postgres, and OpenAPI",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "start": "node --import ./src/instrumentation.ts src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "scripts/check-migrations.sh",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.ts",
    "gen:feature": "node scripts/gen-feature.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "openapi:generate": "node scripts/generate-openapi.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm db:check && pnpm test:coverage && .agents/check.sh && .github/scripts/check-repo-standards.sh",
    "test:generator": "vitest run --config vitest.generator.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/otel": "^1.3.0",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@clack/prompts": "^1.8.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.1.0",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
