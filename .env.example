# Dev-only credentials, matching compose.yaml. Replace them everywhere else.
DATABASE_URL=postgres://api_app:api_app_dev_password@127.0.0.1:5432/api
MIGRATION_DATABASE_URL=postgres://api_owner:api_owner_dev_password@127.0.0.1:5432/api

# 3001, so pnpm dev can run next to the Compose API on 3000. Compose reads API_PORT, not PORT.
PORT=3001
LOG_LEVEL=info
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=

# How many proxies in front of the API append to X-Forwarded-For. 0 ignores the header.
TRUST_PROXY_HOPS=0

# Serves /docs and /openapi.json. Off by default; leave it off in production unless you mean to publish them.
DOCS_ENABLED=true

SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
# Failed logins allowed per email in each window of LOGIN_FAILURE_WINDOW_SECONDS.
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900

# On SIGTERM, fail /readyz and keep serving for the drain, then give requests in flight the timeout.
SHUTDOWN_DRAIN_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=30

# Set to send traces, errors, and metrics to an OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
