# Dev-only credentials, matching compose.yaml. Replace them everywhere else.
DATABASE_URL=postgres://api_app:api_app_dev_password@127.0.0.1:5432/api
MIGRATION_DATABASE_URL=postgres://api_owner:api_owner_dev_password@127.0.0.1:5432/api

PORT=3000
LOG_LEVEL=info
DATABASE_STATEMENT_TIMEOUT_MS=5000

# Comma-separated browser origins. Leave empty to disable CORS.
CORS_ORIGINS=

# Set to true only behind a proxy that appends to X-Forwarded-For.
TRUST_PROXY=false

SESSION_TTL_HOURS=168
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10

# Set to send traces and errors to an OTLP collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
